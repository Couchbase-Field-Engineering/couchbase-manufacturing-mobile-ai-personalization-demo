# Copy to .env. docker-compose.yml passes these to the backend;
# scripts/register_with_aom.py fills in the AOM_* values for you.

# --- Couchbase Agent Operations Manager (its own compose stack on this machine) ---
AOM_URL=https://host.docker.internal:8090
AOM_AGENT_API_KEY=
AOM_ADMIN_USERNAME=admin
AOM_ADMIN_PASSWORD=
AOM_VERIFY_TLS=false
# The URL AOM uses to reach this backend's MCP server.
AOM_MCP_PUBLIC_URL=http://host.docker.internal:8204/mfg/mcp
# The AOM dashboard as your browser reaches it - linked from the story page.
AOM_DASHBOARD_URL=https://localhost

# --- Sync Gateway URL handed to phones (use your Mac's LAN IP for a physical device) ---
SG_PUBLIC_URL=ws://localhost:4992/manufacturing

# --- Optional ---
# "Today" for the demo; defaults to the export_date of the loaded Databricks export.
# DEMO_TODAY=2026-11-13
# Illustrative cost per warehouse / Model Serving call behind the story's "spend avoided" counter.
# DBX_COST_PER_QUERY_USD=0.035
